# Copy this file to .env (same folder) and fill it in.
# .env is in .gitignore: it is never uploaded anywhere. Never share it.

# REQUIRED: the private key of a NEW wallet used only for this bot.
# 64 hex characters, with or without 0x. Your wallet address is worked out from it.
WALLET_PRIVATE_KEY=your-private-key-here

# OPTIONAL: an upper limit on any single buy, in US dollars (empty = no limit).
# A good idea for your first weeks, e.g. 25.
MAX_TRADE_USD=

# OPTIONAL: where the bot keeps its memory and logs (default: the data folder here).
# On Railway set this to the path of your volume, e.g. /data.
DATA_DIR=

# OPTIONAL: "swaps" (default) builds each 4-hour candle from every trade in the pool;
# "samples" uses 20-minute price samples instead.
CANDLE_SOURCE=swaps

# OPTIONAL: "on" (default) uses the Trend Core + Range Harvester strategy;
# "off" uses the Trend Bot + Range Harvester instead (any WBTC the Trend Core
# holds is then sold at the next cycle).
TREND_CORE=on

# OPTIONAL: "yes" makes the bot send the one-time router approvals itself at
# start-up if they're missing (useful on Railway). "no" (default): the
# Start Bot file asks you to type YES instead.
AUTO_APPROVE=no

# OPTIONAL: a free CoinGecko demo key, only used for the one-time history warm-up
# on a first start (it usually works without one).
COINGECKO_API_KEY=
